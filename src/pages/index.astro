---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator';
import SEOSection from '../components/SEOSection.astro';

const title = "Finals Calculator | What Do I Need to Pass?";
const description = "Free finals calculator. Find exactly what score you need on your final exam to pass or reach your target grade. Easy, fast, and accurate.";
---

<Layout title={title} description={description}>
	<main class="relative">
		{/* Hero Header */}
		<header class="pt-20 pb-12 text-center px-4 max-w-3xl mx-auto space-y-6">
			<!--   -->
			<h1 class="text-4xl md:text-6xl font-black tracking-tight text-black dark:text-white leading-tight">
				Will I Pass <br />
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-500">My Finals?</span>
			</h1>
			<p class="text-lg text-gray-600 dark:text-slate-400 font-medium">
				Stop stressing and start calculating. Our real-time engine tells you exactly what score you need to crush your finals.
			</p>
		</header>

		{/* The Interactive Island */}
		<section class="pb-20">
			<Calculator client:load />
		</section>

		{/* SEO Section */}
		<div class="bg-gray-50 dark:bg-slate-900/30 border-t border-gray-200 dark:border-white/5">
			<SEOSection />
		</div>
	</main>
</Layout>
