---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator';
import SEOSection from '../components/SEOSection.astro';

const title = "Finals Calculator | What Do I Need to Pass?";
const description = "Free finals calculator. Find exactly what score you need on your final exam to pass or reach your target grade. Easy, fast, and accurate.";
---

<Layout title={title} description={description}>
	<Fragment slot="head">
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			"name": "Pass My Finals Calculator",
			"applicationCategory": "EducationalApplication",
			"operatingSystem": "WebBrowser",
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "USD"
			},
			"description": "Free final grade calculator to find exactly what score you need on your final exam to pass or reach your target grade."
		}
		</script>
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
			{
				"@type": "Question",
				"name": "What is a weighted grade?",
				"acceptedAnswer": {
				"@type": "Answer",
				"text": "A weighted grade means different assignments are worth more than others. For example, a final exam worth 30% of your grade has the same impact as 30 homework assignments worth 1% each."
				}
			},
			{
				"@type": "Question",
				"name": "How do drop lowest calculations work?",
				"acceptedAnswer": {
				"@type": "Answer",
				"text": "Drop lowest allows you to remove your worst scoring assignment from the grade calculation, effectively removing those points from the denominator and raising your current percentage."
				}
			},
			{
				"@type": "Question",
				"name": "What if the calculator says Impossible?",
				"acceptedAnswer": {
				"@type": "Answer",
				"text": "Impossible means that even with a perfect 100% on the final exam, you cannot mathematically reach your target grade based on your current standing and the exam weight."
				}
			}
			]
		}
		</script>
	</Fragment>
	<main class="relative">
		{/* Hero Header */}
		<header class="pt-20 pb-12 text-center px-4 max-w-3xl mx-auto space-y-6">
			<!--   -->
			<h1 class="text-4xl md:text-6xl font-black tracking-tight text-black dark:text-white leading-tight">
				Will I Pass <br />
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-500">My Finals?</span>
			</h1>
			<p class="text-lg text-gray-600 dark:text-slate-400 font-medium">
				Stop stressing and start calculating. Our real-time engine tells you exactly what score you need to crush your finals.
			</p>
		</header>

		{/* The Interactive Island */}
		<section class="pb-20">
			<Calculator client:load />
		</section>

		{/* SEO Section */}
		<div class="bg-gray-50 dark:bg-slate-900/30 border-t border-gray-200 dark:border-white/5">
			<SEOSection />
		</div>
	</main>
</Layout>
