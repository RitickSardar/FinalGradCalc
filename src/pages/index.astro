---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator';
import SEOSection from '../components/SEOSection.astro';

const title = "Premium Final Grade Calculator | Pass My Finals";
const description = "Calculate exactly what you need on your final exam to reach your target grade. Interactive 'What-If' slider, weighted calculations, and drop-lowest options.";
---

<Layout title={title} description={description}>
	<main class="relative">
		{/* Hero Header */}
		<header class="pt-20 pb-12 text-center px-4 max-w-3xl mx-auto space-y-6">
			<span class="inline-block px-4 py-1.5 rounded-full  border border-blue-700 dark:border-blue-300 text-blue-700 dark:text-blue-300 text-xs font-bold uppercase tracking-widest animate-pulse">
				Production Ready Tool
			</span>
			<h1 class="text-4xl md:text-6xl font-black tracking-tight text-black dark:text-white leading-tight">
				Premium Final <br />
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-500">Grade Calculator</span>
			</h1>
			<p class="text-lg text-gray-600 dark:text-slate-400 font-medium">
				Stop stressing and start calculating. Our real-time engine tells you exactly what score you need to crush your finals.
			</p>
		</header>

		{/* The Interactive Island */}
		<section class="pb-20">
			<Calculator client:load />
		</section>

		{/* SEO Section */}
		<div class="bg-gray-50 dark:bg-slate-900/30 border-t border-gray-200 dark:border-white/5">
			<SEOSection />
		</div>
	</main>
</Layout>
