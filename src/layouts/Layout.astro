

---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Calculate exactly what you need on your final exam to reach your target grade. Interactive 'What-If' slider, weighted calculations, and drop-lowest options." } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = (path: string) => {
	if (path === '/') return pathname === '/';
	return pathname.startsWith(path);
};
---

<html lang="en" class="bg-gray-50 dark:bg-black">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
		<script is:inline>
			(function() {
				const getThemePreference = () => {
					if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
						return localStorage.getItem('theme');
					}
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				};
				const isDark = getThemePreference() === 'dark';
				document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
				if (typeof localStorage !== 'undefined') {
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				}
			})();
		</script>
	</head>
	<body class="text-gray-900 dark:text-gray-50 font-['Inter',sans-serif] selection:bg-blue-500/30 transition-colors duration-300">
		
		{/* Interactive Dots Canvas */}
		<canvas id="dotsCanvas" class="fixed inset-0 -z-20 pointer-events-none"></canvas>

		{/* Animated Background Mesh */}
		<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
			<div class="absolute -top-[10%] -left-[10%] w-[40%] h-[40%] rounded-full bg-blue-600/10 blur-[120px]"></div>
			<div class="absolute top-[20%] -right-[5%] w-[30%] h-[30%] rounded-full bg-indigo-600/10 blur-[100px]"></div>
			<div class="absolute -bottom-[10%] left-[20%] w-[50%] h-[50%] rounded-full bg-black/5 dark:bg-black/20 blur-[120px]"></div>
		</div>

		<nav class="w-full border-b border-gray-200 dark:border-white/10 bg-white/50 dark:bg-black/50 backdrop-blur-md sticky top-0 z-50 transition-colors duration-300">
			<div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
				<div class="flex items-center gap-2">
					<a href="/" class="flex items-center gap-2">
						<div class="w-8 h-8 bg-black dark:bg-white rounded-lg flex items-center justify-center font-black text-white dark:text-black text-xl shadow-lg transition-colors duration-300">%</div>
						<span class="font-bold text-xl tracking-tight text-black dark:text-white transition-colors duration-300">PassMyFinals<span class="text-blue-500">.com</span></span>
					</a>
				</div>
				<div class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600 dark:text-gray-400">
					<a href="/" class={`transition-colors ${isActive('/') ? 'text-blue-600 dark:text-blue-400 font-bold' : 'hover:text-black dark:hover:text-white'}`}>Calculator</a>
					<a href="/grade-scale" class={`transition-colors ${isActive('/grade-scale') ? 'text-blue-600 dark:text-blue-400 font-bold' : 'hover:text-black dark:hover:text-white'}`}>Grade Scale</a>
					<a href="/gpa-calculator" class={`transition-colors ${isActive('/gpa-calculator') ? 'text-blue-600 dark:text-blue-400 font-bold' : 'hover:text-black dark:hover:text-white'}`}>GPA Calc</a>
					<button id="theme-toggle" class="bg-gray-200 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20 text-black dark:text-white px-3 py-1.5 rounded-full border border-gray-300 dark:border-white/10 transition-all flex items-center gap-2">
						<svg id="theme-toggle-light-icon" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
						<svg id="theme-toggle-dark-icon" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
						<span id="theme-toggle-text">Theme</span>
					</button>
					<button class="bg-black dark:bg-white hover:bg-gray-800 dark:hover:bg-gray-200 text-white dark:text-black px-4 py-2 rounded-full border border-gray-800 dark:border-white/10 transition-all font-semibold">Sign In</button>
				</div>
			</div>
		</nav>

		<slot />

		<footer class="border-t border-gray-200 dark:border-white/10 py-12 bg-transparent transition-colors duration-300">
			<div class="max-w-7xl mx-auto px-4 text-center space-y-4">
				<p class="text-gray-500 dark:text-gray-400 text-sm">
					&copy; {new Date().getFullYear()} PassMyFinals.com. Built for high-performance students.
				</p>
				<div class="flex justify-center gap-6 text-xs text-gray-500 dark:text-gray-500">
					{/* Changed these from <a> tags to <button> tags to trigger the modals */}
					<button onclick="privacyModal.showModal()" class="hover:text-black dark:hover:text-gray-300 transition-colors cursor-pointer">Privacy Policy</button>
					<button onclick="tosModal.showModal()" class="hover:text-black dark:hover:text-gray-300 transition-colors cursor-pointer">Terms of Service</button>
					
					{/* This triggers their default email client */}
					<a href="https://github.com/RitickSardar" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-gray-300 transition-colors">GitHub Source</a>
				</div>
			</div>
		</footer>

		{/* --- The Modals --- */}
		
		{/* Privacy Modal */}
		<dialog id="privacyModal" class="bg-white dark:bg-slate-900 text-slate-900 dark:text-white p-6 rounded-2xl shadow-2xl backdrop:bg-black/40 backdrop:backdrop-blur-sm border border-gray-200 dark:border-slate-800 max-w-md w-full m-auto open:animate-in open:fade-in open:zoom-in-95 duration-200">
			<div class="flex items-center gap-3 mb-4">
				<div class="p-2 bg-blue-500/10 rounded-xl border border-blue-500/20">
					<svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
				</div>
				<h2 class="text-xl font-bold">Honest Privacy Policy</h2>
			</div>
			<p class="text-sm text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
				This calculator runs 100% locally in your browser. We don't use databases, we don't sell your data, and we definitely don't track your grades. Your late-night academic math is strictly between you and your screen.
			</p>
			<form method="dialog" class="flex justify-end">
				<button class="px-5 py-2.5 bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-gray-900 dark:text-white rounded-xl text-sm font-semibold transition-colors cursor-pointer border border-gray-200 dark:border-slate-700">Understood</button>
			</form>
		</dialog>

		{/* Terms of Service Modal */}
		<dialog id="tosModal" class="bg-white dark:bg-slate-900 text-slate-900 dark:text-white p-6 rounded-2xl shadow-2xl backdrop:bg-black/40 backdrop:backdrop-blur-sm border border-gray-200 dark:border-slate-800 max-w-md w-full m-auto open:animate-in open:fade-in open:zoom-in-95 duration-200">
			<div class="flex items-center gap-3 mb-4">
				<div class="p-2 bg-purple-500/10 rounded-xl border border-purple-500/20">
					<svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
				</div>
				<h2 class="text-xl font-bold">Terms of Service</h2>
			</div>
			<p class="text-sm text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
				This is a free tool built to help you plan your finals. While we ensure the math logic is bulletproof, we are not responsible if your professor curves the test differently or if you sleep through your alarm. Use it as a guide, and good luck!
			</p>
			<form method="dialog" class="flex justify-end">
				<button class="px-5 py-2.5 bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-gray-900 dark:text-white rounded-xl text-sm font-semibold transition-colors cursor-pointer border border-gray-200 dark:border-slate-700">Sounds Fair</button>
			</form>
		</dialog>

		<script is:inline>
			(function() {
				const themeToggleBtn = document.getElementById('theme-toggle');
				const darkIcon = document.getElementById('theme-toggle-dark-icon');
				const lightIcon = document.getElementById('theme-toggle-light-icon');
				const textSpan = document.getElementById('theme-toggle-text');

				if (!themeToggleBtn) return;

				function updateIcon() {
					if (document.documentElement.classList.contains('dark')) {
						lightIcon.classList.remove('hidden');
						darkIcon.classList.add('hidden');
						if(textSpan) textSpan.textContent = "Light";
					} else {
						lightIcon.classList.add('hidden');
						darkIcon.classList.remove('hidden');
						if(textSpan) textSpan.textContent = "Dark";
					}
				}

				updateIcon();

				themeToggleBtn.addEventListener('click', function(e) {
					const x = e.clientX || innerWidth / 2;
					const y = e.clientY || innerHeight / 2;
					const endRadius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

					const isCurrentlyDark = document.documentElement.classList.contains('dark');
					const nextTheme = isCurrentlyDark ? 'light' : 'dark';

					if (!document.startViewTransition) {
						document.documentElement.classList.toggle('dark');
						localStorage.setItem('theme', nextTheme);
						updateIcon();
						return;
					}

					document.documentElement.classList.add(isCurrentlyDark ? 'transitioning-to-light' : 'transitioning-to-dark');

					const transition = document.startViewTransition(() => {
						document.documentElement.classList.toggle('dark');
						localStorage.setItem('theme', nextTheme);
						updateIcon();
					});

					transition.ready.then(() => {
						const clipPath = [
							`circle(0px at ${x}px ${y}px)`,
							`circle(${endRadius}px at ${x}px ${y}px)`,
						];
						
						document.documentElement.animate(
							{
								clipPath: isCurrentlyDark ? [...clipPath].reverse() : clipPath,
							},
							{
								duration: 500,
								easing: 'ease-in-out',
								fill: 'forwards',
								pseudoElement: isCurrentlyDark ? '::view-transition-old(root)' : '::view-transition-new(root)',
							}
						);
					});

					transition.finished.then(() => {
						document.documentElement.classList.remove('transitioning-to-light', 'transitioning-to-dark');
					});
				});
			})();
		</script>

		<script is:inline>
			(function() {
				const canvas = document.getElementById('dotsCanvas');
				if (!canvas) return;
				const ctx = canvas.getContext('2d');
				let width, height;
				let dots = [];
				const spacing = 28; // Space between dots
				const baseRadius = 1.5; // Slightly larger base dot
				const mouse = { x: -1000, y: -1000 };

				function init() {
					width = canvas.width = window.innerWidth;
					height = canvas.height = window.innerHeight;
					dots = [];
					for (let x = 0; x < width; x += spacing) {
						for (let y = 0; y < height; y += spacing) {
							dots.push({ x, y, originX: x, originY: y });
						}
					}
				}

				window.addEventListener('resize', init);
				window.addEventListener('mousemove', (e) => {
					mouse.x = e.clientX;
					mouse.y = e.clientY;
				});
				window.addEventListener('mouseout', () => {
					mouse.x = -1000;
					mouse.y = -1000;
				});

				function animate() {
					ctx.clearRect(0, 0, width, height);
					const isDark = document.documentElement.classList.contains('dark');
					// Dark mode dots are lighter, Light mode dots are darker
					ctx.fillStyle = isDark ? 'rgba(255, 255, 255, 0.25)' : 'rgba(0, 0, 0, 0.15)';

					for (let i = 0; i < dots.length; i++) {
						let dot = dots[i];
						let dx = mouse.x - dot.originX;
						let dy = mouse.y - dot.originY;
						let dist = Math.sqrt(dx * dx + dy * dy);
						
						// Magnetic repel radius
						let force = Math.max(0, 150 - dist) / 150; 
						
						let targetX = dot.originX - (dx * force * 0.6);
						let targetY = dot.originY - (dy * force * 0.6);
						
						// Smooth interpolation
						dot.x += (targetX - dot.x) * 0.15;
						dot.y += (targetY - dot.y) * 0.15;

						ctx.beginPath();
						// Optional: size also pulses slightly when repelled
						let radius = baseRadius + (force * 1.5);
						ctx.arc(dot.x, dot.y, radius, 0, Math.PI * 2);
						ctx.fill();
					}
					requestAnimationFrame(animate);
				}

				init();
				animate();
			})();
		</script>

		
	</body>
</html>
